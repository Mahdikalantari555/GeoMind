# GeoFoundation Gateway — environment template
# Copy to `.env` and fill in. Server-side secrets only — never commit the real file.
# (Root .gitignore excludes .env.)

# ── LLM (hybrid: remote OpenAI-compatible API by default, local GGUF fallback)
# Provider API key value. The gateway reads it from the process environment at
# call time. It may also be set at runtime via PUT /api/v1/workspace/settings
# (admin token required); in that case it is set in-process only — never
# persisted to the workspace DB and never returned by any response.
GEOMEMORY_LLM_API_KEY=
# Env var name the workspace setting `llm_api_key_env` resolves to (default below).
# GEOMEMORY_LLM_API_KEY_ENV=GEOMEMORY_LLM_API_KEY
# OpenAI-compatible base URL (optional; omit for the provider default).
# GEOMEMORY_LLM_API_BASE_URL=https://api.openai.com/v1
# Model id used when the workspace does not override it.
# GEOMEMORY_LLM_MODEL_ID=gpt-4o-mini

# ── Qdrant (optional; only when vector_backend=qdrant)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── Gateway
# Bind address. Loopback by default; set 0.0.0.0 only when the port is otherwise
# isolated (containers, reverse proxy). Auth is enabled when GEOMIND_API_TOKEN
# is non-empty; GEOMIND_AUTH=off is an explicit local-dev opt-out.
# GEOMIND_BIND=127.0.0.1
# GEOMIND_API_TOKEN=
# Admin-scoped token for settings/providers/environment/model routes. When
# unset, GEOMIND_API_TOKEN also carries admin scope.
# GEOMIND_ADMIN_TOKEN=
# Comma-separated allowed CORS origins (defaults to the Vite dev ports).
# GEOMIND_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Log level: DEBUG | INFO | WARNING | ERROR
# GEOMEMORY_LOG_LEVEL=INFO

# Studio Settings → Add provider → Fetch models. Set matching keys on the gateway.
# GEOMEMORY_OPENAI_API_KEY=
# GEOMEMORY_OPENROUTER_API_KEY=
# For a custom OpenAI-compatible endpoint use GEOMEMORY_LLM_API_BASE_URL
# and GEOMEMORY_LLM_API_KEY above. Base URLs must not contain credentials.
# Custom connection wizard: comma-separated exact HTTPS bases approved for discovery.
# After connecting, set the dedicated GEOMEMORY_PROVIDER_..._KEY shown in Studio.
# GEOMIND_APPROVED_PROVIDER_BASES=https://my-provider.example/v1

# ── Workspace & state (where data lives; NEVER commit a workspace)
# Canonical names use the GEOMIND_ prefix. Legacy GEOFOND_/GEOFONT_ names are
# still accepted as fallbacks so existing deployments keep working.
# GEOMIND_WORKSPACE=/path/to/Workspaces
# GEOMIND_STATE_PATH=/path/to/Workspaces/.geofront/active_workspace

# ── Embedding / Hugging Face cache (offline-first defaults)
# Point these at local mirrors or a mounted cache to avoid network egress.
# HF_ENDPOINT=https://hf-mirror.example
# HF_HOME=/path/to/hf-cache
# GEOMEMORY_EMBEDDING_ROOT=/path/to/embedding-models
