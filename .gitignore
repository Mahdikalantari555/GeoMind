# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.run

# Node
node_modules/
dist/
*.local

# Runtime data (never commit workspaces, models, or secrets)
Workspaces/
**/workspace/
**/workspaces/
/Workspaces/
.geofront/
**/.geofront/
# exception: keep the web workspace feature source tracked
!/apps/web/src/features/workspace/
**/.env
**/.env.*
!**/.env.example

# QA screenshots: captured locally by scripts/qa/*.cjs into docs/qa/<pass>/{before,after}/.
# Screenshots stay out of git; the reports describe them in prose and the
# observations JSON (the machine-readable evidence) stays tracked.
docs/qa/**/*.jpg
docs/qa/**/*.jpeg
docs/qa/**/*.png

# OS / editors
.DS_Store
Thumbs.db
in-memoria.db

# Agent / tooling config
# .agents/, .opencode/, .vscode/ are tracked by git (skills + config).
.mimocode/
.kilo/
.worktrees/
.memdb/
.zvec-grep/
.repocairn/

# Test artifacts
**/screenshots/
**/test-results/

.coverage
.coverage.*
*.coverage
sample/output/
geomemory-evals/
