		"bits-ui": "^2.20.3",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"svelte": "^5.57.2",
